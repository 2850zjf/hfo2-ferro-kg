# Copy this file to .env for local-only settings.
# Never commit .env or API keys.

OPENAI_API_KEY=
HFO2_FERROKG_LLM_PROVIDER=openai
HFO2_FERROKG_LLM_MODEL=gpt-4.1-mini
HFO2_FERROKG_LLM_BASE_URL=
HFO2_FERROKG_LLM_TIMEOUT_SECONDS=60
HFO2_FERROKG_LLM_MAX_TOKENS=4000
HFO2_FERROKG_LLM_ENABLE_THINKING=false
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HFO2_FERROKG_USE_LLM=true
HFO2_FERROKG_DB_PATH=data/hfo2_ferrokg.sqlite3
HFO2_FERROKG_PDF_ROOT=data/raw_pdfs
HFO2_FERROKG_LOG_LEVEL=INFO
